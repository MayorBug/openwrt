#!/bin/sh

. /lib/functions/caldata.sh

board=$(board_name)

if [ -e "/lib/firmware/$FIRMWARE" ]; then
	case "$board:$FIRMWARE" in
	cudy,p5:ath11k/IPQ5018/hw1.0/cal-ahb-c000000.wifi.bin|\
	cudy,p5:ath11k/QCN6122/hw1.0/cal-ahb-b00a040.wifi.bin)
		[ "$(wc -c < "/lib/firmware/$FIRMWARE")" -eq 131072 ] 2>/dev/null && exit 0
		logger -t caldata "replacing incomplete P5 calibration file: $FIRMWARE"
		;;
	*)
		exit 0
		;;
	esac
fi

p5_caldata_error() {
	logger -t caldata "$FIRMWARE: $*"
	caldata_die "$*"
}

p5_caldata_extract() (
	local offset=$1
	local mac_offset=$2
	local target="/lib/firmware/$FIRMWARE"
	local count=131072
	local mtd bdinfo wlan_mac tmp

	mtd=$(find_mtd_chardev "0:art")
	bdinfo=$(find_mtd_chardev bdinfo)
	[ -n "$mtd" ] && [ -n "$bdinfo" ] || p5_caldata_error "ART or bdinfo partition not found"
	wlan_mac=$(get_mac_binary "$bdinfo" 0xde00)
	[ "${#wlan_mac}" -eq 17 ] || p5_caldata_error "cannot read MAC address from bdinfo"
	wlan_mac=$(macaddr_add "$wlan_mac" "$mac_offset")

	mkdir -p "${target%/*}" || p5_caldata_error "cannot create calibration directory"
	tmp=$(mktemp "$target.XXXXXX") || p5_caldata_error "cannot create calibration temporary file"
	trap 'rm -f "$tmp"' 0
	trap 'exit 1' 1 2 15

	caldata_dd "$mtd" "$tmp" "$count" "$offset" || p5_caldata_error "ART calibration read failed"
	[ "$(wc -c < "$tmp")" -eq "$count" ] || p5_caldata_error "ART calibration read is incomplete"
	(
		ath11k_patch_mac "$wlan_mac" 0 "$tmp"
		ath11k_set_macflag "$tmp"
	) || p5_caldata_error "calibration MAC patch failed"
	[ "$(wc -c < "$tmp")" -eq "$count" ] || p5_caldata_error "calibration size changed after MAC patch"
	chmod 644 "$tmp" || p5_caldata_error "cannot set calibration file permissions"
	mv -f "$tmp" "$target" || p5_caldata_error "cannot publish calibration file"
	logger -t caldata "prepared P5 calibration file: $FIRMWARE ($count bytes)"
)

# tplink,ex511-v2: 0:ART ships fully erased (verified 100% 0xFF). Stock reads
# ART, fails to LZMA-decompress it, and falls back to a zero-filled dummy
# (see /lib/read_caldata_to_fs.sh in the stock rootfs), so the radios run on
# board-data defaults. ath11k hard-fails if the cal file is simply absent, so
# provide the same zero-filled dummy stock ends up with. Do NOT synthesise one
# from the board data blob -- that loads but breaks scanning.

case "$FIRMWARE" in
"ath11k/IPQ5018/hw1.0/cal-ahb-c000000.wifi.bin")
	case "$board" in
	cmcc,mr3000d-ci)
		caldata_extract "0:art" 0x1000 0x20000
		wlan_mac=$(mtd_get_mac_binary 0:art 12)
		ath11k_patch_mac $wlan_mac 0
		ath11k_set_macflag
		ath11k_remove_regdomain
		;;
	cudy,p5)
		p5_caldata_extract 0x1000 0 || exit 1
		;;
	elecom,wrc-x3000gs2|\
	elecom,wrc-x3000gst2|\
	iodata,wn-dax3000gr|\
	zyxel,scr50axe)
		caldata_extract "0:art" 0x1000 0x20000
		wlan_mac=$(mtd_get_mac_ascii 0:appsblenv wifi0)
		ath11k_patch_mac $wlan_mac 0
		ath11k_set_macflag
		;;
	glinet,gl-b3000)
		caldata_extract "0:art" 0x1000 0x20000
		ath11k_patch_mac $(macaddr_add $(get_mac_label_dt) 3) 0
		ath11k_set_macflag
		;;
	glinet,gl-x2000)
		caldata_extract "0:art" 0x1000 0x20000
		ath11k_patch_mac $(macaddr_add $(mtd_get_mac_binary "0:art" 0x6) 2) 0
		ath11k_set_macflag
		;;
	linksys,mr5500|\
	linksys,mx2000|\
	linksys,mx5500|\
	linksys,spnmx56)
		caldata_extract "0:art" 0x1000 0x20000
		label_mac=$(mtd_get_mac_ascii devinfo hw_mac_addr)
		ath11k_patch_mac $(macaddr_add $label_mac 1) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	linksys,mx6200)
		caldata_extract "0:art" 0x1000 0x20000
		label_mac=$(mtd_get_mac_ascii devinfo hw_mac_addr)
		ath11k_patch_mac $(macaddr_add $label_mac 2) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	mercusys,mr80x-v2)
		caldata_extract "0:art" 0x1000 0x20000
		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		[ -n "$label_mac" ] && ath11k_patch_mac "$(macaddr_add "$label_mac" -1)" 0
		ath11k_set_macflag
		;;
	tplink,archer-ax55-v1)
		caldata_extract "0:ART" 0x1000 0x20000
		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		[ -n "$label_mac" ] && ath11k_patch_mac "$(macaddr_add "$label_mac" 2)" 0
		ath11k_set_macflag
		ath11k_remove_regdomain
		;;
	tplink,eap650-outdoor-v1)
		caldata_from_file "/tmp/factory_data/radio" 0 0x20000
		label_mac=$(get_mac_binary /tmp/factory_data/default-mac 0)
		ath11k_patch_mac $label_mac 0
		ath11k_set_macflag
		;;
	xiaomi,ax6000|\
	xiaomi,redmi-ax5400)
		caldata_extract "0:art" 0x1000 0x20000
		;;
	tplink,ex511-v2)
		dd if=/dev/zero of=/lib/firmware/$FIRMWARE bs=4096 count=32 2>/dev/null
		;;
	yuncore,ax830|\
	yuncore,ax850)
		caldata_extract "0:ART" 0x1000 0x20000
		label_mac=$(mtd_get_mac_binary 0:ART 0)
		ath11k_patch_mac $(macaddr_add $label_mac 2) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	esac
	;;
"ath11k/QCN6122/hw1.0/cal-ahb-b00a040.wifi.bin")
	case "$board" in
	cmcc,mr3000d-ci)
		caldata_extract "0:art" 0x26800 0x20000
		wlan_mac=$(mtd_get_mac_binary 0:art 18)
		ath11k_patch_mac $wlan_mac 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	cudy,p5)
		p5_caldata_extract 0x26800 2 || exit 1
		;;
	elecom,wrc-x3000gs2|\
	elecom,wrc-x3000gst2|\
	iodata,wn-dax3000gr|\
	zyxel,scr50axe)
		caldata_extract "0:art" 0x26800 0x20000
		wlan_mac=$(mtd_get_mac_ascii 0:appsblenv wifi1)
		ath11k_patch_mac $wlan_mac 0
		ath11k_set_macflag
		;;
	glinet,gl-b3000)
		caldata_extract "0:art" 0x26800 0x20000
		ath11k_patch_mac $(macaddr_add $(get_mac_label_dt) 4) 0
		ath11k_set_macflag
		;;
	linksys,mx2000)
		caldata_extract "0:art" 0x26800 0x20000
		label_mac=$(mtd_get_mac_ascii devinfo hw_mac_addr)
		ath11k_patch_mac $(macaddr_add $label_mac 2) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	linksys,mx6200)
		caldata_extract "0:art" 0x26800 0x20000
		label_mac=$(mtd_get_mac_ascii devinfo hw_mac_addr)
		ath11k_patch_mac $(macaddr_add $label_mac 3) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	mercusys,mr80x-v2)
		caldata_extract "0:art" 0x26800 0x20000
		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		[ -n "$label_mac" ] && ath11k_patch_mac "$(macaddr_add "$label_mac" -2)" 0
		ath11k_set_macflag
		;;
	tplink,archer-ax55-v1)
		caldata_extract "0:ART" 0x26800 0x20000
		label_mac=$(get_mac_binary "/tmp/tp_data/default-mac" 0)
		[ -n "$label_mac" ] && ath11k_patch_mac "$(macaddr_add "$label_mac" 3)" 0
		ath11k_set_macflag
		ath11k_remove_regdomain
		;;
	tplink,ex511-v2)
		dd if=/dev/zero of=/lib/firmware/$FIRMWARE bs=4096 count=32 2>/dev/null
		;;
	yuncore,ax830)
		caldata_extract "0:ART" 0x4c000 0x20000
		label_mac=$(mtd_get_mac_binary 0:ART 0)
		ath11k_patch_mac $(macaddr_add $label_mac 3) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	esac
	;;
"ath11k/QCN6122/hw1.0/cal-ahb-b00b040.wifi.bin")
	case "$board" in
	glinet,gl-x2000)
		caldata_extract "0:art" 0x26800 0x20000
		ath11k_patch_mac $(macaddr_add $(mtd_get_mac_binary "0:art" 0x6) 3) 0
		ath11k_set_macflag
		;;
	linksys,mx6200)
		caldata_extract "0:art" 0x4c000 0x20000
		label_mac=$(mtd_get_mac_ascii devinfo hw_mac_addr)
		ath11k_patch_mac $(macaddr_add $label_mac 4) 0
		ath11k_remove_regdomain
		;;
	zyxel,scr50axe)
		caldata_extract "0:art" 0x4C000 0x20000
		wlan_mac=$(mtd_get_mac_ascii 0:appsblenv wifi2)
		ath11k_patch_mac $wlan_mac 0
		ath11k_set_macflag
		;;
	esac
	;;
"ath11k/QCN9074/hw1.0/cal-pci-0000:01:00.0.bin")
	case "$board" in
	linksys,mr5500|\
	linksys,mx5500|\
	linksys,spnmx56)
		caldata_extract "0:art" 0x26800 0x20000
		label_mac=$(mtd_get_mac_ascii devinfo hw_mac_addr)
		ath11k_patch_mac $(macaddr_add $label_mac 2) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	tplink,eap650-outdoor-v1)
		caldata_from_file "/tmp/factory_data/radio1" 0 0x20000
		label_mac=$(get_mac_binary /tmp/factory_data/default-mac 0)
		ath11k_patch_mac $(macaddr_add $label_mac 1) 0
		ath11k_set_macflag
		;;
	xiaomi,ax6000|\
	xiaomi,redmi-ax5400)
		caldata_extract "0:art" 0x26800 0x20000
		;;
	yuncore,ax850)
		caldata_extract "0:ART" 0x26800 0x20000
		label_mac=$(mtd_get_mac_binary 0:ART 0)
		ath11k_patch_mac $(macaddr_add $label_mac 3) 0
		ath11k_remove_regdomain
		ath11k_set_macflag
		;;
	esac
	;;
*)
	exit 1
	;;
esac
