validate_p5_caldata() {
	[ "$(cat /tmp/sysinfo/board_name)" = "cudy,p5" ] || return 0

	local firmware target
	for firmware in \
		ath11k/IPQ5018/hw1.0/cal-ahb-c000000.wifi.bin \
		ath11k/QCN6122/hw1.0/cal-ahb-b00a040.wifi.bin; do
		target="/lib/firmware/$firmware"
		[ -e "$target" ] || continue
		[ "$(wc -c < "$target")" -eq 131072 ] 2>/dev/null && continue

		echo "caldata: removing incomplete P5 calibration file: $firmware"
		rm -f "$target" || echo "caldata: cannot remove $target"
	done
}

boot_hook_add preinit_main validate_p5_caldata
